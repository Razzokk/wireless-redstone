{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}+${minecraft_version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"license": "${mod_license}",
	"icon": "assets/${mod_id}/icon.png",
	"environment": "*",
	"authors": [ "${mod_author}" ],
	"contact": {
		"homepage": "${curseforge_page}",
		"issues": "${sources}/issues",
		"sources": "${sources}"
	},
	"entrypoints": {
		"main": [
			"rzk.wirelessredstone.WirelessRedstoneFabric"
		],
		"client": [
			"rzk.wirelessredstone.client.WirelessRedstoneClientFabric"
		],
		"modmenu": [
			"rzk.wirelessredstone.client.WRModMenu"
		]
	},
	"mixins": [
		"${mod_id}.mixins.json",
		"${mod_id}.fabric.mixins.json"
	],
	"depends": {
		"java": ">=${java_version}",
		"minecraft": "${fabric_minecraft_version_range}",
		"fabricloader": "${fabric_loader_range}",
		"fabric-api": "*"
	},
	"suggests": {
		"cloth-config": ">=${cloth_config_version}",
		"modmenu": ">=${modmenu_version}"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.curseforge": "${curseforge_page}",
				"modmenu.modrinth": "${modrinth_page}",
				"modmenu.discord": "${discord}"
			}
		}
	}
}
